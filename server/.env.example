# Copy to server/.env (gitignored) and fill in. Real environment variables win over this file.

# Shared secret: the device's secrets.h and charm-client send it in `hello`.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
CHARM_TOKEN=
# Where the server listens and where charm-client connects.
CHARM_HOST=127.0.0.1
CHARM_PORT=8765

# --- The agent -------------------------------------------------------------------------------
# openai (default): any OpenAI-compatible chat-completions endpoint.
# hermes: a Hermes agent container, reached over SSH + docker exec (see the Hermes block below).
CHARM_AGENT=openai
# OpenAI:                        https://api.openai.com/v1
# Anthropic (OpenAI SDK compat): https://api.anthropic.com/v1/
# Ollama (local):                http://127.0.0.1:11434/v1   (no key needed)
# LM Studio (local):             http://127.0.0.1:1234/v1
CHARM_AGENT_BASE_URL=https://api.openai.com/v1
# Falls back to OPENAI_API_KEY. Leave empty for local servers.
CHARM_AGENT_API_KEY=
# The model name your endpoint serves: an OpenAI model id, a Claude model id, `llama3.2`, ...
CHARM_AGENT_MODEL=

# --- Who it's for (optional; neutral wording when empty) --------------------------------------
# Your first name, used in the agent prompts ("You are Dex, Sam's agent").
CHARM_OWNER_NAME=
# Where actions can happen instead (the charm is read-and-converse only), e.g. Telegram.
CHARM_MAIN_CHAT=
# IANA zone for the clock, welcome.tz and card timestamps. Empty: this machine's zone.
CHARM_TZ=

# --- Hermes backend (CHARM_AGENT=hermes) -----------------------------------------------------
# ssh <alias> docker exec -i <container> python -   (alias `local` = the server runs on that host)
HERMES_SSH_ALIAS=hermes
HERMES_CONTAINER=hermes-agent
# 1 (default): one persistent SSH channel, answers streamed. 0: ssh per question.
HERMES_CHANNEL=1

# --- Optional --------------------------------------------------------------------------------
# CHARM_CARDS_DIR=../contract/examples      # edition/pending cards (e.g. the feeds output)
# CHARM_SCHEMA=../contract/card.schema.json
# CHARM_ACTION_LOG=.local/actions.jsonl     # decision/money actions are logged here
# CHARM_VOICE_EN=en-US-AndrewNeural         # any Edge TTS voice (`edge-tts --list-voices`)
# CHARM_VOICE_ES=es-ES-AlvaroNeural
# CHARM_WHISPER_MODEL=base

# ElevenLabs speech (optional, an API key): a voice id per character puts ElevenLabs in front of
# that character's Edge voice, which stays as the fallback. No key, or no voice id: Edge only.
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_flash_v2_5        # fast and multilingual
# ELEVENLABS_VOICE_EN=                      # voice id (Voice Library → ID); also speaks Spanish
# ELEVENLABS_VOICE_ES=                      # optional: a different voice for Spanish
# ELEVENLABS_VOICE_COACH_EN=                # optional: Coach (empty = Coach stays on Edge)
# ELEVENLABS_VOICE_COACH_ES=

# Reading mode
# CHARM_BOOKS=.local/books.json             # per-book session (gitignored)
# Where "save this" goes: file (default: one Markdown file per note in CHARM_NOTES_DIR) |
# osapi (an HTTP knowledge service, see notes/README.md) | fake (in memory) | off.
# CHARM_NOTES=file
# CHARM_NOTES_DIR=.local/notes

# --- Coach Beard: an optional second agent (docs/COACH.md) -----------------------------------
# COACH_ENABLED=0
# COACH_MODEL=                              # openai backend: his model (empty = Dex's model)
# Hermes backend: a second Hermes profile. His key is read INSIDE the container from
# COACH_ENV_PATH; the charm calls his container-local API on COACH_PORT.
# COACH_ENV_PATH=/opt/data/profiles/coach/.env
# COACH_PORT=8644
# COACH_API_PATH=/v1                       # Hermes v2026.9.24+ (one multiplexed gateway):
#                                           # COACH_PORT=8642 and COACH_API_PATH=/p/coach/v1
# COACH_LEDGER_PATH=                        # his read-only decision ledger (the fast path)
# COACH_JOBS=.local/coach-jobs.json         # walk-away results waiting for the device (gitignored)
# CHARM_VOICE_COACH_EN=en-US-ChristopherNeural
# CHARM_VOICE_COACH_ES=es-MX-JorgeNeural
