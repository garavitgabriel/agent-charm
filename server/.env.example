# Copy to server/.env (gitignored) and fill in. Real environment variables win over this file.

# Shared secret: the device's secrets.h and charm-client send it in `hello`.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
CHARM_TOKEN=
# Where the server listens and where charm-client connects.
CHARM_HOST=127.0.0.1
CHARM_PORT=8765

# Dex (Hermes), reached like Margin: ssh <alias> docker exec -i <container> python -
HERMES_SSH_ALIAS=hermes
HERMES_CONTAINER=hermes-agent

# Optional
# CHARM_CARDS_DIR=../contract/examples      # edition/pending cards (feeds output later)
# CHARM_SCHEMA=../contract/card.schema.json
# CHARM_ACTION_LOG=.local/actions.jsonl     # decision/money actions are logged here
# CHARM_TZ=America/Chicago
# CHARM_VOICE_EN=en-US-AndrewNeural
# CHARM_VOICE_ES=es-CO-GonzaloNeural
# CHARM_WHISPER_MODEL=base
