# Copy to server/.env (gitignored) and fill in. Real environment variables win over this file.

# Shared secret: the device's secrets.h and charm-client send it in `hello`.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
CHARM_TOKEN=
# Where the server listens and where charm-client connects.
CHARM_HOST=127.0.0.1
CHARM_PORT=8765

# Dex (Hermes), reached like Margin: ssh <alias> docker exec -i <container> python -
HERMES_SSH_ALIAS=hermes
HERMES_CONTAINER=hermes-agent
# 1 (default): one persistent SSH channel to Dex, answers streamed. 0: ssh per question (old path).
HERMES_CHANNEL=1

# Optional
# CHARM_CARDS_DIR=../contract/examples      # edition/pending cards (feeds output later)
# CHARM_SCHEMA=../contract/card.schema.json
# CHARM_ACTION_LOG=.local/actions.jsonl     # decision/money actions are logged here
# CHARM_TZ=America/Chicago
# CHARM_VOICE_EN=en-US-AndrewNeural
# CHARM_VOICE_ES=es-CO-GonzaloNeural
# CHARM_WHISPER_MODEL=base

# Reading mode
# CHARM_BOOKS=.local/books.json             # per-book session (gitignored)
# Where "save this" goes: osapi (OS knowledge service, inbox only) | fake (in memory) | off.
# osapi reads OS_API_BASE / OS_API_TOKEN (or ~/.os-api.env); never put the token here in git.
# CHARM_NOTES=osapi

# Coach Beard (the `coach` Hermes profile): same SSH/docker transport as Dex. His key is read
# INSIDE the container from COACH_ENV_PATH; the charm calls his container-local API on COACH_PORT.
# COACH_ENABLED=1
# COACH_ENV_PATH=/opt/data/profiles/coach/.env
# COACH_PORT=8644
# COACH_LEDGER_PATH=/opt/data/profiles/coach/data/decisions/decisions.jsonl   # read-only fast path
# COACH_JOBS=.local/coach-jobs.json         # walk-away results waiting for the device (gitignored)
# CHARM_VOICE_COACH_EN=en-US-ChristopherNeural
# CHARM_VOICE_COACH_ES=es-MX-JorgeNeural
