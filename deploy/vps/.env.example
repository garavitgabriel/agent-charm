# .env next to compose.yaml on the host (chmod 600). Never commit the real one.
CHARM_TOKEN=            # python3 -c "import secrets; print(secrets.token_urlsafe(24))"
CHARM_BIND=127.0.0.1    # host address the port binds to (see README: public endpoint)
CHARM_TZ=UTC            # your IANA zone, e.g. Europe/Madrid
CHARM_OWNER_NAME=       # optional: your first name, for the agent prompts
CHARM_NOTES=file        # "save this" → /app/server/.local/notes (./state/notes on the host)

# The agent: any OpenAI-compatible endpoint...
CHARM_AGENT=openai
CHARM_AGENT_BASE_URL=https://api.openai.com/v1
CHARM_AGENT_API_KEY=
CHARM_AGENT_MODEL=

# ...or a Hermes container on this host (uncomment the docker.sock volume in compose.yaml).
# CHARM_AGENT=hermes
# HERMES_SSH_ALIAS=local
# HERMES_CONTAINER=hermes-agent
# CHARM_MAIN_CHAT=Telegram

# Optional second agent (docs/COACH.md)
# COACH_ENABLED=1
# ElevenLabs speech (optional, an API key): a voice id per character puts ElevenLabs in front of
# that character's Edge voice, which stays as the fallback. No key, or no voice id: Edge only.
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_flash_v2_5        # fast and multilingual
# ELEVENLABS_VOICE_EN=                      # voice id (Voice Library → ID); also speaks Spanish
# ELEVENLABS_VOICE_ES=                      # optional: a different voice for Spanish
# ELEVENLABS_VOICE_COACH_EN=                # optional: Coach (empty = Coach stays on Edge)
# ELEVENLABS_VOICE_COACH_ES=
